@app.get("/api/pagos/rut/{rut_pagador}")
def consultar_pagos_por_rut(rut_pagador: str):
    with SessionLocal() as db:
        resultados = db.execute(
            select(
                Pago.id,
                Pago.fecha_pago,
                Pago.monto_pago,
                Pago.estado,
                MovimientoBancario.id.label("movimiento_id"),
                MovimientoBancario.descripcion_original,
                MovimientoBancario.tipo_movimiento,
            )
            .join(
                MovimientoBancario,
                MovimientoBancario.id == Pago.movimiento_bancario_id,
            )
            .where(
                MovimientoBancario.rut_pagador_detectado == rut_pagador
            )
            .order_by(
                Pago.fecha_pago.asc(),
                Pago.id.asc(),
            )
        ).all()

        return [
            {
                "pago_id": pago_id,
                "fecha_pago": fecha_pago,
                "monto_pago": monto_pago,
                "estado": estado,
                "movimiento_id": movimiento_id,
                "descripcion": descripcion,
                "tipo_movimiento": tipo_movimiento,
            }
            for (
                pago_id,
                fecha_pago,
                monto_pago,
                estado,
                movimiento_id,
                descripcion,
                tipo_movimiento,
            ) in resultados
        ]
@app.get("/api/pagos/rut/{rut_pagador}/candidatos")
def candidatos_por_rut_pagador(rut_pagador: str):
    with SessionLocal() as db:

        # --------------------------------------------------------
        # 1. OBTENER PAGOS DEL RUT PAGADOR
        # --------------------------------------------------------

        pagos = db.execute(
            select(
                Pago.id,
                Pago.fecha_pago,
                Pago.monto_pago,
            )
            .join(
                MovimientoBancario,
                MovimientoBancario.id == Pago.movimiento_bancario_id,
            )
            .where(
                MovimientoBancario.rut_pagador_detectado == rut_pagador
            )
            .order_by(
                Pago.fecha_pago.asc(),
                Pago.id.asc(),
            )
        ).all()

        resultado = []

        # --------------------------------------------------------
        # 2. PROCESAR CADA PAGO
        # --------------------------------------------------------

        for pago_id, fecha_pago, monto_pago in pagos:

            documentos = db.scalars(
                select(DocumentoTributario)
                .where(
                    DocumentoTributario.saldo_pendiente > 0
                )
                .order_by(
                    DocumentoTributario.fecha_documento.desc(),
                    DocumentoTributario.folio.desc(),
                )
                .limit(200)
            ).all()

            candidatos = []

            # ----------------------------------------------------
            # 3. BUSCAR CANDIDATOS
            # ----------------------------------------------------

            for documento in documentos:

                # -----------------------------------------------
                # BUSCAR CLIENTE POR RUT DEL DOCUMENTO
                # -----------------------------------------------

                cliente = db.scalar(
                    select(Cliente)
                    .where(
                        Cliente.rut == documento.rut_cliente
                    )
                    .limit(1)
                )

                if cliente:
                    cliente_id = cliente.id
                    razon_social_cliente = cliente.razon_social
                else:
                    cliente_id = None
                    razon_social_cliente = documento.razon_social

                # -----------------------------------------------
                # CALCULAR DIFERENCIA
                # -----------------------------------------------

                diferencia = (
                    documento.saldo_pendiente - monto_pago
                )

                diferencia_abs = abs(diferencia)

                # -----------------------------------------------
                # NIVEL DE COINCIDENCIA POR MONTO
                # -----------------------------------------------

                if diferencia == 0:
                    nivel_monto = "EXACTA"

                elif diferencia_abs <= 1000:
                    nivel_monto = "MUY_CERCANA"

                elif diferencia_abs <= 10000:
                    nivel_monto = "CERCANA"

                elif diferencia_abs <= 50000:
                    nivel_monto = "MEDIA"

                else:
                    continue

                # -----------------------------------------------
                # DIFERENCIA DE FECHAS
                # -----------------------------------------------

                if documento.fecha_documento:
                    dias_diferencia = (
                        fecha_pago - documento.fecha_documento
                    ).days
                else:
                    dias_diferencia = None

                # -----------------------------------------------
                # PRIORIDAD POR FECHA
                # -----------------------------------------------

                if dias_diferencia is None:
                    prioridad_fecha = "SIN_FECHA"

                elif dias_diferencia >= 0:
                    # Documento anterior o del mismo día
                    prioridad_fecha = "ALTA"

                elif dias_diferencia >= -30:
                    # Documento futuro cercano
                    prioridad_fecha = "MEDIA"

                else:
                    # Documento muy posterior al pago
                    prioridad_fecha = "BAJA"

                # -----------------------------------------------
                # PUNTAJE
                # -----------------------------------------------

                puntaje = 0

                # MONTO
                if diferencia == 0:
                    puntaje += 700

                elif diferencia_abs <= 1000:
                    puntaje += 500

                elif diferencia_abs <= 10000:
                    puntaje += 300

                elif diferencia_abs <= 50000:
                    puntaje += 100

                # FECHA
                if dias_diferencia is not None:

                    if 0 <= dias_diferencia <= 30:
                        puntaje += 150

                    elif dias_diferencia > 30:
                        puntaje += 100

                    elif -30 <= dias_diferencia < 0:
                        puntaje += 40

                    else:
                        puntaje -= 50

                # CLIENTE IDENTIFICADO
                if cliente_id is not None:
                    puntaje += 100

                candidatos.append(
                    {
                        "cliente_id": cliente_id,
                        "rut_cliente": documento.rut_cliente,
                        "razon_social": razon_social_cliente,

                        "documento_id": documento.id,
                        "tipo_documento": documento.tipo_documento,
                        "folio": documento.folio,

                        "fecha_documento": documento.fecha_documento,

                        "monto_documento": documento.monto_total,
                        "saldo_pendiente": documento.saldo_pendiente,

                        "diferencia": diferencia,
                        "nivel_monto": nivel_monto,

                        "dias_diferencia": dias_diferencia,
                        "prioridad_fecha": prioridad_fecha,

                        "puntaje": puntaje,
                    }
                )

            # ----------------------------------------------------
            # 4. ORDENAR CANDIDATOS
            # ----------------------------------------------------

            candidatos.sort(
                key=lambda x: (
                    -x["puntaje"],
                    abs(x["diferencia"]),
                    x["fecha_documento"]
                    if x["fecha_documento"]
                    else fecha_pago,
                )
            )

            # ----------------------------------------------------
            # 5. GUARDAR RESULTADO DEL PAGO
            # ----------------------------------------------------

            resultado.append(
                {
                    "pago_id": pago_id,
                    "fecha_pago": fecha_pago,
                    "monto_pago": monto_pago,
                    "candidatos": candidatos[:20],
                }
            )

        # --------------------------------------------------------
        # 6. RESPUESTA
        # --------------------------------------------------------

        return {
            "rut_pagador": rut_pagador,
            "pagos": resultado,
        }
       
@app.post("/api/movimientos-bancarios/importar-santander")

async def importar_cartola_santander(

    archivo: UploadFile = File(...),

    cuenta_bancaria_gh_id: int = Form(...),

):

    """

    Importa una cartola histórica Santander en formato XLSX.



    Primera etapa:

    - Lee los movimientos de la hoja "Detalle movimientos".

    - Guarda cargos y abonos.

    - Detecta RUT dentro de la descripción.

    - No realiza conciliación automática.

    """



    if not archivo.filename:

        raise HTTPException(

            status_code=400,

            detail="No se recibió ningún archivo.",

        )



    nombre_archivo = archivo.filename



    if not nombre_archivo.lower().endswith(".xlsx"):

        raise HTTPException(

            status_code=400,

            detail="La cartola Santander debe estar en formato .xlsx.",

        )



    contenido = await archivo.read()



    if not contenido:

        raise HTTPException(

            status_code=400,

            detail="El archivo está vacío.",

        )



    # --------------------------------------------------------

    # LEER ARCHIVO SANTANDER

    # --------------------------------------------------------



    try:

        excel = pd.ExcelFile(io.BytesIO(contenido), engine="openpyxl")



        if "Cartola Historica CtaCte" not in excel.sheet_names:

            raise HTTPException(

                status_code=400,

                detail={

                    "mensaje": (

                        "La cartola Santander no contiene la hoja 'Cartola Historica CtaCte'."

                    ),

                    "hojas_detectadas": excel.sheet_names,

                },

            )



        df = pd.read_excel(

            io.BytesIO(contenido),

            sheet_name="Cartola Historica CtaCte",

            header=None,

            engine="openpyxl",

        )



    except HTTPException:

        raise



    except Exception as e:

        raise HTTPException(

            status_code=400,

            detail=f"No fue posible leer la cartola Santander: {str(e)}",

        )



    # --------------------------------------------------------

    # BUSCAR FILA DE ENCABEZADOS

    # --------------------------------------------------------



    fila_encabezado = None



    for indice, fila in df.iterrows():

        valores = [

            str(valor).strip().upper()

            for valor in fila.tolist()

            if pd.notna(valor)

        ]



        if (

            "MONTO" in valores

            and "FECHA" in valores

            and "CARGO/ABONO" in valores

        ):

            fila_encabezado = indice

            break



    if fila_encabezado is None:

        raise HTTPException(

            status_code=400,

            detail=(

                "No se encontró la estructura esperada "

                "de movimientos Santander."

            ),

        )



    # --------------------------------------------------------

    # RELEER USANDO EL ENCABEZADO ENCONTRADO

    # --------------------------------------------------------



    df_movimientos = pd.read_excel(

        io.BytesIO(contenido),

        sheet_name="Cartola Historica CtaCte",

        header=fila_encabezado,

        engine="openpyxl",

    )



    # Normalizar nombres de columnas

    df_movimientos.columns = [

        str(columna).strip()

        for columna in df_movimientos.columns

    ]



    columnas_requeridas = [

        "MONTO",

        "DESCRIPCIÓN MOVIMIENTO",

        "FECHA",

        "N° DOCUMENTO",

        "SUCURSAL",

        "CARGO/ABONO",

    ]



    columnas_faltantes = [

        columna

        for columna in columnas_requeridas

        if columna not in df_movimientos.columns

    ]



    if columnas_faltantes:

        raise HTTPException(

            status_code=400,

            detail={

                "mensaje": (

                    "La cartola Santander no tiene "

                    "todas las columnas esperadas."

                ),

                "columnas_faltantes": columnas_faltantes,

                "columnas_detectadas": list(df_movimientos.columns),

            },

        )



    # --------------------------------------------------------

    # FILTRAR FILAS REALES DE MOVIMIENTOS

    # --------------------------------------------------------



    df_movimientos = df_movimientos[

        df_movimientos["FECHA"].notna()

        & df_movimientos["MONTO"].notna()

        & df_movimientos["CARGO/ABONO"].notna()

    ].copy()



    if df_movimientos.empty:

        raise HTTPException(

            status_code=400,

            detail="No se encontraron movimientos bancarios en la cartola.",

        )



    # --------------------------------------------------------

    # CONECTAR A BASE DE DATOS

    # --------------------------------------------------------



    with SessionLocal() as db:

        try:

            cuenta = db.get(

                CuentaBancariaGH,

                cuenta_bancaria_gh_id,

            )



            if cuenta is None:

                raise HTTPException(

                    status_code=404,

                    detail=(

                        "No existe la cuenta bancaria GH indicada."

                    ),

                )



            # ------------------------------------------------

            # CREAR IMPORTACIÓN

            # ------------------------------------------------



            importacion = ImportacionBancaria(

                cuenta_bancaria_gh_id=cuenta_bancaria_gh_id,

                nombre_archivo=nombre_archivo,

                fecha_desde=None,

                fecha_hasta=None,

                cantidad_registros=0,

                estado="procesando",

            )



            db.add(importacion)

            db.flush()



            cantidad_importados = 0

            cantidad_rut_detectado = 0

            cantidad_revision = 0



            fechas = []



            # ------------------------------------------------

            # PROCESAR MOVIMIENTOS

            # ------------------------------------------------



            for _, fila in df_movimientos.iterrows():



                try:

                    fecha_valor = fila["FECHA"]



                    fecha = pd.to_datetime(

                        fecha_valor,

                        dayfirst=True,

                        errors="coerce",

                    )



                    if pd.isna(fecha):

                        continue



                    fecha = fecha.date()



                    monto_valor = fila["MONTO"]



                    if isinstance(monto_valor, str):

                        monto_limpio = (

                            monto_valor

                            .replace(".", "")

                            .replace(",", ".")

                            .replace("$", "")

                            .strip()

                        )

                    else:

                        monto_limpio = monto_valor



                    monto = Decimal(str(monto_limpio))



                    descripcion = str(

                        fila["DESCRIPCIÓN MOVIMIENTO"]

                    ).strip()



                    if descripcion == "nan":

                        descripcion = ""



                    numero_documento = str(

                        fila["N° DOCUMENTO"]

                    ).strip()



                    if numero_documento == "nan":

                        numero_documento = None



                    sucursal = str(

                        fila["SUCURSAL"]

                    ).strip()



                    if sucursal == "nan":

                        sucursal = None



                    cargo_abono = str(

                        fila["CARGO/ABONO"]

                    ).strip().upper()



                    # ------------------------------------------------

                    # DETECTAR RUT

                    # ------------------------------------------------



                    rut_detectado = detectar_rut_en_texto(

                        descripcion

                    )



                    if rut_detectado:

                        cantidad_rut_detectado += 1

                    else:

                        cantidad_revision += 1



                    # ------------------------------------------------

                    # MONTOS CARGO / ABONO

                    # ------------------------------------------------



                    monto_abono = None

                    monto_cargo = None



                    if cargo_abono == "A":

                        monto_abono = abs(monto)



                    elif cargo_abono == "C":

                        monto_cargo = abs(monto)



                    # ------------------------------------------------

                    # TIPO MOVIMIENTO

                    # ------------------------------------------------



                    if cargo_abono == "A":

                        tipo_movimiento = "ABONO"

                    elif cargo_abono == "C":

                        tipo_movimiento = "CARGO"

                    else:

                        tipo_movimiento = cargo_abono



                    movimiento = MovimientoBancario(

                        importacion_bancaria_id=importacion.id,

                        fecha_movimiento=fecha,

                        descripcion_original=descripcion,

                        numero_documento=numero_documento,

                        sucursal=sucursal,

                        tipo_movimiento=tipo_movimiento,

                        monto=monto,

                        cargo_abono=cargo_abono,

                        monto_abono=monto_abono,

                        monto_cargo=monto_cargo,

                        saldo_diario=None,

                        rut_pagador_detectado=rut_detectado,

                        nombre_pagador_detectado=None,

                    )



                    db.add(movimiento)



                    fechas.append(fecha)

                    cantidad_importados += 1



                except Exception:

                    # Una fila inválida no debe guardar datos

                    # incompletos. Se ignora por ahora.

                    continue



            if cantidad_importados == 0:

                db.rollback()



                raise HTTPException(

                    status_code=400,

                    detail=(

                        "No se pudo importar ningún movimiento "

                        "válido de la cartola."

                    ),

                )



            # ------------------------------------------------

            # ACTUALIZAR IMPORTACIÓN

            # ------------------------------------------------



            importacion.cantidad_registros = cantidad_importados

            importacion.estado = "importada"



            if fechas:

                importacion.fecha_desde = min(fechas)

                importacion.fecha_hasta = max(fechas)



            db.commit()



            return {

                "mensaje": "Cartola Santander importada correctamente.",

                "importacion_id": importacion.id,

                "archivo": nombre_archivo,

                "cuenta_bancaria_gh_id": cuenta_bancaria_gh_id,

                "movimientos_importados": cantidad_importados,

                "rut_detectados": cantidad_rut_detectado,

                "requieren_revision": cantidad_revision,

                "fecha_desde": (

                    min(fechas).isoformat()

                    if fechas

                    else None

                ),

                "fecha_hasta": (

                    max(fechas).isoformat()

                    if fechas

                    else None

                ),

            }



        except HTTPException:

            raise



        except Exception as e:

            db.rollback()



            raise HTTPException(

                status_code=500,

                detail=(

                    "Ocurrió un error al importar la cartola Santander: "

                    f"{str(e)}"

                ),

            )

